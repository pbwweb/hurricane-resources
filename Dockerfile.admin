# Dockerfile for Hurricane Resources Admin Application
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
USER app
EXPOSE 8080
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy project files
COPY ["HurricaneResources.Web.Admin/HurricaneResources.Web.Admin.csproj", "HurricaneResources.Web.Admin/"]
COPY ["HurricaneResources.Shared/HurricaneResources.Shared.csproj", "HurricaneResources.Shared/"]
COPY ["HurricaneResources.ServiceDefaults/HurricaneResources.ServiceDefaults.csproj", "HurricaneResources.ServiceDefaults/"]

# Restore dependencies
RUN dotnet restore "./HurricaneResources.Web.Admin/HurricaneResources.Web.Admin.csproj"

# Copy all source code
COPY . .

# Build the application
WORKDIR "/src/HurricaneResources.Web.Admin"
RUN dotnet build "./HurricaneResources.Web.Admin.csproj" -c "${BUILD_CONFIGURATION}" -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./HurricaneResources.Web.Admin.csproj" -c "${BUILD_CONFIGURATION}" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "HurricaneResources.Web.Admin.dll"]